{
  "name": "sigaa-me",
  "private": true,
  "version": "1.2.0",
  "description": "Desktop app for UFC's SIGAA",
  "author": "Bruno Lage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Laginho/SIGAA-ME.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "release": "tsc && vite build && electron-builder --win --publish never",
    "release:patch": "standard-version --release-as patch && git push --follow-tags origin HEAD",
    "release:minor": "standard-version --release-as minor && git push --follow-tags origin HEAD",
    "release:major": "standard-version --release-as major && git push --follow-tags origin HEAD",
    "release:patch:beta": "standard-version --release-as patch --prerelease beta && git push --follow-tags origin HEAD",
    "release:minor:beta": "standard-version --release-as minor --prerelease beta && git push --follow-tags origin HEAD",
    "release:major:beta": "standard-version --release-as major --prerelease beta && git push --follow-tags origin HEAD",
    "release:beta": "standard-version --prerelease beta && git push --follow-tags origin HEAD",
    "preview": "npm run build && start .\\release\\%npm_package_version%\\win-unpacked\\SIGAA-ME.exe",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 52",
    "quality": "npm run typecheck && npm run lint && npm test",
    "test:watch": "vitest",
    "test:live": "vitest run tests/integration/scraper.test.ts",
    "test:e2e": "tsc && vite build && playwright test",
    "coverage": "vitest run --coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/mime-types": "^3.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "electron": "^41.10.7",
    "electron-builder": "^26.16.1",
    "eslint": "^9.20.0",
    "jsdom": "^29.0.2",
    "standard-version": "^9.5.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.11"
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.0.0",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "mime-types": "^3.0.2",
    "playwright": "^1.63.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true
  }
}
